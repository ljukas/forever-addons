{
  "version": "2.0.0",
  "tasks": [
    { "label": "Fetch API references", "type": "shell", "command": "scripts/setup.sh", "problemMatcher": [] },
    { "label": "Show in-game dev log", "type": "shell", "command": "scripts/devlog.sh", "problemMatcher": [] },
    { "label": "Link addons into WoW", "type": "shell", "command": "scripts/link.sh", "problemMatcher": [] },
    { "label": "Lint", "type": "shell", "command": "scripts/lint.sh", "problemMatcher": [], "group": { "kind": "test", "isDefault": true } },
    { "label": "Format", "type": "shell", "command": "stylua addons template types", "problemMatcher": [] },
    {
      "label": "New addon",
      "type": "shell",
      "command": "scripts/new-addon.sh ${input:addonName}",
      "problemMatcher": []
    },
    {
      "label": "Package addon (local zip)",
      "type": "shell",
      "command": "scripts/package.sh ${input:addonName}",
      "problemMatcher": []
    }
  ],
  "inputs": [{ "id": "addonName", "type": "promptString", "description": "Addon folder name (PascalCase, e.g. MyAddon)" }]
}
