package-as: ForeverUnitFrames

# Fetched for development by scripts/libs.sh; never edited or committed (its licence allows
# bundling it unmodified). Loaded in its namespaced mode (Libs/LibEditMode/namespaced.lua), so
# LibStub isn't needed.
externals:
  Libs/LibEditMode:
    url: https://github.com/p3lim-wow/LibEditMode
    tag: "19"

# Dev/ holds probes that only log; releases leave it out (see CLAUDE.md).
ignore:
  - Dev

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
