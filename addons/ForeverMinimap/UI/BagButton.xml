<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\..\..\..\WoW\Data\Interface\AddOns\Blizzard_SharedXML\UI.xsd">
	<Script file="BagButton.lua"/>

	<!-- The button on the minimap ring that opens the button bag: the minimap's dark round
	     background, an icon, and the gold ring Forever draws round its day and night indicator
	     (BorderAtlas in Blizzard_Minimap/Camelot/Diel.lua), so it matches the minimap's own art.
	     The zoom buttons' highlight shows on mouseover. It is created in BagButton.lua with
	     Minimap as its parent, and its icon is picked there. -->
	<Button name="ForeverMinimapBagButtonTemplate" mixin="ForeverMinimapBagButtonMixin" virtual="true">
		<Size x="31" y="31"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture file="Interface\Minimap\UI-Minimap-Background">
					<Size x="24" y="24"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon">
					<Size x="12" y="12"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<Texture parentKey="Ring" atlas="UI-HUD-Minimap-Frame-Cycle" setAllPoints="true"/>
			</Layer>
		</Layers>
		<Scripts>
			<OnClick method="OnClick"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
			<OnDragStart method="OnDragStart"/>
			<OnDragStop method="OnDragStop"/>
			<OnMouseDown method="OnMouseDown"/>
			<OnMouseUp method="OnMouseUp"/>
			<OnShow method="OnShow"/>
			<OnHide method="OnHide"/>
		</Scripts>
		<HighlightTexture file="Interface\Minimap\UI-Minimap-ZoomButton-Highlight" alphaMode="ADD"/>
	</Button>
</Ui>
