{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "Lua 5.1",
  "runtime.builtin": {
    "basic": "disable",
    "debug": "disable",
    "io": "disable",
    "math": "disable",
    "os": "disable",
    "package": "disable",
    "string": "disable",
    "table": "disable",
    "utf8": "disable"
  },
  "workspace.library": [
    ".cache/wow-api/Annotations/Core",
    "types",
    ".cache/wow-ui-source/Interface"
  ],
  "workspace.ignoreDir": [
    ".release",
    ".cache",
    ".vscode",
    "scripts"
  ],
  "workspace.checkThirdParty": false,
  "diagnostics.disable": [
    "lowercase-global"
  ]
}
