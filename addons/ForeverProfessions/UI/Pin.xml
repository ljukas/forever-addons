<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\..\..\..\WoW\Data\Interface\AddOns\Blizzard_SharedXML\UI.xsd">
	<Script file="Pin.lua"/>

	<!-- Node pin, laid out like Blizzard's round tracking button (WorldMapTrackingPinButtonTemplate):
	     dark minimap background, the node's item icon (or the profession tracking atlas) made round
	     with the mask Blizzard uses on round icons (Blizzard_PVPUI.xml), and the gold tracking ring.
	     Mouse motion only, so clicks still reach the map and the minimap. -->
	<Frame name="ForeverProfessionsPinTemplate" mixin="ForeverProfessionsPinMixin" enableMouseMotion="true" virtual="true">
		<Size x="32" y="32"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Background" file="Interface\Minimap\UI-Minimap-Background">
					<Size x="25" y="25"/>
					<Anchors>
						<Anchor point="TOPLEFT" x="3" y="-4"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon">
					<Size x="20" y="20"/>
					<Anchors>
						<Anchor point="TOPLEFT" x="7" y="-6"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<MaskTexture parentKey="Mask" atlas="CircleMaskScalable" hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE">
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.Icon"/>
						<Anchor point="BOTTOMRIGHT" relativeKey="$parent.Icon"/>
					</Anchors>
					<MaskedTextures>
						<MaskedTexture childKey="Icon"/>
					</MaskedTextures>
				</MaskTexture>
			</Layer>
			<Layer level="OVERLAY" textureSubLevel="1">
				<Texture parentKey="Border" file="Interface\Minimap\MiniMap-TrackingBorder">
					<Size x="54" y="54"/>
					<Anchors>
						<Anchor point="TOPLEFT"/>
					</Anchors>
				</Texture>
			</Layer>
			<!-- How many nodes a merged pin stands for, on the icon's lower right like a stack
			     count on an item button. -->
			<Layer level="OVERLAY" textureSubLevel="2">
				<FontString parentKey="Count" inherits="NumberFontNormalLarge" justifyH="RIGHT" hidden="true">
					<Anchors>
						<Anchor point="BOTTOMRIGHT" relativeKey="$parent.Icon" x="4" y="-3"/>
					</Anchors>
				</FontString>
			</Layer>
			<Layer level="HIGHLIGHT">
				<Texture file="Interface\Minimap\UI-Minimap-ZoomButton-Highlight" alphaMode="ADD" setAllPoints="true"/>
			</Layer>
		</Layers>
	</Frame>

	<!-- World map pins get their mouse scripts from the map canvas (AcquirePin). -->
	<Frame name="ForeverProfessionsWorldPinTemplate" inherits="ForeverProfessionsPinTemplate" mixin="ForeverProfessionsWorldPinMixin" hidden="true" virtual="true"/>

	<Frame name="ForeverProfessionsMinimapPinTemplate" inherits="ForeverProfessionsPinTemplate" virtual="true">
		<Scripts>
			<OnEnter method="OnMouseEnter"/>
			<OnLeave method="OnMouseLeave"/>
		</Scripts>
	</Frame>
</Ui>
