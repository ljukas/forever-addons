<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\..\..\..\WoW\Data\Interface\AddOns\Blizzard_SharedXML\UI.xsd">
	<Script file="BagButton.lua"/>

	<!-- The button on the minimap ring that opens the button bag, drawn like every other addon's
	     minimap button (LibDBIcon's, Cinematic's): the minimap's dark round background, the gold
	     tracking-button ring and the zoom buttons' highlight. Forever's own minimap buttons use the
	     Camelot ui-hud-minimap-* art, which has no plain round button. The ring texture's circle
	     fills its top-left, so at 50 pixels anchored TOPLEFT it centres on the 31-pixel button.
	     It is created in BagButton.lua with Minimap as its parent, and its icon is picked there. -->
	<Button name="ForeverMinimapBagButtonTemplate" mixin="ForeverMinimapBagButtonMixin" virtual="true">
		<Size x="31" y="31"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture file="Interface\Minimap\UI-Minimap-Background">
					<Size x="24" y="24"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon">
					<Size x="16" y="16"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<Texture file="Interface\Minimap\MiniMap-TrackingBorder">
					<Size x="50" y="50"/>
					<Anchors>
						<Anchor point="TOPLEFT"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnClick method="OnClick"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
			<OnDragStart method="OnDragStart"/>
			<OnDragStop method="OnDragStop"/>
			<OnMouseDown method="OnMouseDown"/>
			<OnMouseUp method="OnMouseUp"/>
			<OnShow method="OnShow"/>
			<OnHide method="OnHide"/>
		</Scripts>
		<HighlightTexture file="Interface\Minimap\UI-Minimap-ZoomButton-Highlight" alphaMode="ADD"/>
	</Button>
</Ui>
